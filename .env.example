# Copier vers .env.local (dev) ou coller dans Netlify → Site settings → Environment variables.

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Comptes autorisés (défaut : tout @clic-et-moi.com). Seuls ces logins voient Airtable / campagnes.
AUTH_ALLOWED_DOMAINS=clic-et-moi.com
# AUTH_ALLOWED_EMAILS=prestataire@exemple.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Airtable PAT : data.records:read + data.records:write
# (désabos Gazette + app Contenu ACAD : Modules, articles, cours, vidéothèque)
AIRTABLE_PAT=

# PostHog — suivi habitudes sites Softr
# EU: https://eu.i.posthog.com  |  US: https://us.i.posthog.com  (même région que ton dashboard)
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Fillout — analytics modules et mots croisés
# Clé : Fillout → Settings → Developer
# Sur Netlify : coller la même valeur (sans guillemets), puis redéployer. Une clé locale valide ne suffit pas en prod.
FILLOUT_API_KEY=
# Optionnel. Ne pas mettre de guillemets ni d'espace. Si tu l'oublies, l'app utilise déjà cette URL.
# FILLOUT_API_URL=https://api.fillout.com/v1/api

# Fillout — désabonnement Gazette / cours en ligne (On t'envoi un gazette)
# Formulaire public : https://clicetmoi.fillout.com/t/skgM2mEtPVus
FILLOUT_UNSUBSCRIBE_FORM_ID=skgM2mEtPVus

# Softr — magic links Users (Le magic link)
# Softr Dashboard → workspace (en haut à gauche) → API tokens
SOFTR_API_KEY=

# Brevo — campagnes Gazette (On t'envoi un gazette) et sessions cours (Tu cours en ligne ?)
# Clé : Brevo → Settings → SMTP & API → API Keys
# Expéditeur déjà vérifié dans Brevo → Campaigns → Senders
# Important : ne pas activer « Authorised IPs ». Netlify change d’IP à chaque appel, Brevo bloquerait l’envoi.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Optionnel : dossier de listes (sinon le premier dossier existant, ou un dossier "ACAD campagnes")
# BREVO_FOLDER_ID=
